rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'jrahmanansari@gmail.com' ||
        request.auth.token.email == 'jrahmanansari132@gmail.com' ||
        request.auth.token.email == 'jrahmanansari133@gmail.com'
      );
    }
    
    function isInstructor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'instructor' ||
        request.auth.token.role == 'teacher'
      );
    }

    // 1. Quran Mushaf & PDF Documents
    match /quran/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Tafsir PDFs & Classical Volumes
    match /tafsir/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Islamic Library Books & Manuscripts
    match /books/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Course Assets (Videos, PDFs, Lesson Materials)
    match /course/{allPaths=**} {
      allow read: if true;
      allow write: if isInstructor() || isAdmin();
    }

    // 5. User Avatars & Profile Photos (Max 5MB images)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin())
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin())
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // 6. Generated Shahi Status Cards
    match /status-cards/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // 7. Verified Certificates & Diplomas
    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Public Assets (Covers, Badges, Icons)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
