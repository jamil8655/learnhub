rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'jrahmanansari@gmail.com' ||
        request.auth.token.email == 'jrahmanansari132@gmail.com' ||
        request.auth.token.email == 'jrahmanansari133@gmail.com'
      );
    }
    
    // Public Assets (Course Covers, Badges, Icons)
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // User Profile Photos in users/{userId}/profile/... (Permanent Firebase Storage)
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
    
    // User Avatars & Profile Photos (Max 5MB images - Legacy Support)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
    
    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }
  }
}
