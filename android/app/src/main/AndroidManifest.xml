<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Minimum required permissions only ──────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- POST_NOTIFICATIONS: only needed if push notifications are added later -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LearnHubApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LearnHub.Starting"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <!--
        ════════════════════════════════════════════════════════════════════════
        TWA LauncherActivity (from androidbrowserhelper library)
        Opens https://learnhubplatform.com in Chrome as a Trusted Web Activity.

        Benefits over WebView:
          • Google Sign-In works (Google blocks OAuth in custom WebViews)
          • Full Chrome security model (HTTPS enforced, CSP, etc.)
          • Firebase Authentication works natively
          • Firebase App Check works via browser token
          • PDF viewing, downloads, media — all Chrome-native
          • Website updates instantly without app update
        ════════════════════════════════════════════════════════════════════════
        -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:theme="@style/Theme.LearnHub.Starting">

            <!-- TWA target URL: production website -->
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://learnhubplatform.com/" />

            <!-- Fallback: if Chrome not installed, open as Custom Tab or browser -->
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />

            <!-- Status bar color matches LearnHub emerald brand -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/primary" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR_DARK"
                android:resource="@color/primary" />

            <!-- Navigation bar: dark background to match app dark theme -->
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/background_dark" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_DIVIDER_COLOR"
                android:resource="@color/background_dark" />

            <!-- Splash screen during TWA load -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash_icon" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/background_dark" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="400" />

            <!-- ── Launcher intent ─────────────────────────────────────────── -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ── Android App Links: learnhubplatform.com → opens in app ──── -->
            <!-- Requires assetlinks.json at /.well-known/assetlinks.json      -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="learnhubplatform.com" />
            </intent-filter>

        </activity>

        <!--
        TWA Service: required for Digital Asset Link verification.
        Chrome uses this to confirm the app is trusted for learnhubplatform.com
        -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.TwaCustomTabsService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.action.CustomTabsService" />
            </intent-filter>
        </service>

    </application>

</manifest>
