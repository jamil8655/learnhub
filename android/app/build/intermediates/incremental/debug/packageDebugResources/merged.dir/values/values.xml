<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#34d399</color>
    <color name="background_dark">#0b0f19</color>
    <color name="background_dark_secondary">#131929</color>
    <color name="ic_launcher_background">#059669</color>
    <color name="primary">#059669</color>
    <color name="primary_dark">#047857</color>
    <color name="primary_light">#34d399</color>
    <color name="status_bar">#059669</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">LearnHub</string>
    <string name="app_name_full">LearnHub - اسلامک لرننگ پلیٹ فارم</string>
    <string name="launch_url">https://learnhubplatform.com/</string>
    <string name="offline_message">آپ آف لائن ہیں۔ انٹرنیٹ سے منسلک ہوں۔</string>
    <style name="Theme.LearnHub" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryContainer">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>
    <style name="Theme.LearnHub.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">500</item>
        <item name="postSplashScreenTheme">@style/Theme.LearnHub</item>
    </style>
</resources>