rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // LEARNHUB — PRODUCTION FIRESTORE SECURITY RULES
    //
    // Reading conventions used throughout:
    //
    //  * get and list are separated so a document can be readable
    //    without the whole collection being enumerable.
    //
    //  * Field reads use .get(field, default). A direct read of a
    //    field that is absent raises an evaluation error, which
    //    fails the entire rule instead of returning false — this
    //    silently denies legitimate access for older documents.
    //
    //  * Anything a score, a role or money depends on is written
    //    only by the Admin SDK (Cloud Functions), which bypasses
    //    these rules. Clients are refused even for their own data.
    // ============================================================


    // ------------------------------------------------------------
    // AUTHENTICATION
    // ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }


    // ------------------------------------------------------------
    // ADMIN AUTHORITY
    //
    // Granted exclusively through Firebase custom claims, set by the
    // setUserRole Cloud Function. No email address is hard-coded
    // here: the bootstrap list lives in the function, so the first
    // admin can be granted without this file naming anyone.
    // ------------------------------------------------------------

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('role', '') == 'super_admin'
      );
    }

    function isInstructor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'instructor' ||
        request.auth.token.get('role', '') == 'teacher'
      );
    }

    function ownsDoc() {
      return isSignedIn() && resource.data.get('userId', '') == request.auth.uid;
    }

    function keepsOwner() {
      return request.resource.data.get('userId', '') == resource.data.get('userId', '');
    }

    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }


    // ------------------------------------------------------------
    // PRIVILEGED USER FIELDS
    // ------------------------------------------------------------

    function privilegedUserFieldsChanged() {
      return changes([
        'role', 'admin', 'superAdmin', 'status', 'emailVerified',
        'isVerified', 'permissions', 'isInstructor', 'isTeacher'
      ]);
    }


    // ============================================================
    // 1. USERS
    // ============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isOwner(userId)
        && (
          !('role' in request.resource.data) ||
          request.resource.data.role == 'student'
        );

      allow update: if isAdmin() || (isOwner(userId) && !privilegedUserFieldsChanged());
      allow delete: if isAdmin();
    }


    // ============================================================
    // 2. INSTRUCTOR APPLICATIONS
    // ============================================================

    match /instructorApplications/{appId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'submitted';

      // Approval assigns a role, so it is an admin action. The role
      // itself is conferred by setUserRole, not by this document.
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // 3. COURSES
    //
    // Drafts stay private to their author and to admins.
    // ============================================================

    match /courses/{courseId} {
      allow get, list: if
        resource.data.get('status', '') == 'published'
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if isAdmin()
        || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid);

      // Ownership cannot be transferred in either direction.
      allow update: if isAdmin() || (
        isInstructor()
        && resource.data.get('instructorId', '') == request.auth.uid
        && request.resource.data.get('instructorId', '') == request.auth.uid
      );

      allow delete: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);
    }


    // ============================================================
    // 4. LESSONS
    //
    // Existing lesson documents carry neither status nor
    // instructorId — only id, courseId, order and title. Requiring
    // either would deny every lesson already in the database, so a
    // lesson with no status is treated as published, exactly as it
    // behaved before. Setting status: 'draft' still hides one.
    // ============================================================

    match /lessons/{lessonId} {
      allow get, list: if
        resource.data.get('status', 'published') == 'published'
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if isAdmin() || isInstructor();

      allow update, delete: if isAdmin() || (
        isInstructor()
        && resource.data.get('instructorId', '') == request.auth.uid
      );
    }


    // ============================================================
    // 5. QUIZZES
    //
    // Same tolerance as lessons for documents predating `status`.
    //
    // A quiz document must never carry its own answer key: this
    // collection is world-readable. Keys belong in quizAnswerKeys
    // or in the secretQuestions subcollection, both closed below.
    // ============================================================

    match /quizzes/{quizId} {
      allow get, list: if
        resource.data.get('status', 'published') == 'published'
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if isAdmin()
        || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid);

      allow update: if isAdmin() || (
        isInstructor()
        && resource.data.get('instructorId', '') == request.auth.uid
        && request.resource.data.get('instructorId', '') == request.auth.uid
      );

      allow delete: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);
    }

    // Server-side answer key. Readable only by the Admin SDK, which
    // ignores these rules; no client path exists at all.
    match /quizzes/{quizId}/secretQuestions/{questionId} {
      allow read, write: if false;
    }


    // ============================================================
    // 6. QUESTIONS (student-readable, answer-free)
    // ============================================================

    match /questions/{questionId} {
      allow get, list: if
        (
          isSignedIn()
          && !('correctAnswer' in resource.data)
          && !('answerKey' in resource.data)
          && !('correctAnswers' in resource.data)
          && !('correctOption' in resource.data)
        )
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if (
        isAdmin() || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid)
      )
        && !('correctAnswer' in request.resource.data)
        && !('answerKey' in request.resource.data)
        && !('correctAnswers' in request.resource.data)
        && !('correctOption' in request.resource.data);

      allow update: if (
        isAdmin() || (
          isInstructor()
          && resource.data.get('instructorId', '') == request.auth.uid
          && request.resource.data.get('instructorId', '') == request.auth.uid
        )
      )
        && !('correctAnswer' in request.resource.data)
        && !('answerKey' in request.resource.data)
        && !('correctAnswers' in request.resource.data)
        && !('correctOption' in request.resource.data);

      allow delete: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);
    }


    // ============================================================
    // 7. PRIVATE ANSWER KEYS
    // ============================================================

    match /quizAnswerKeys/{questionId} {
      allow read: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create, update, delete: if isAdmin()
        || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid);
    }


    // ============================================================
    // 8. ENROLLMENTS
    // ============================================================

    match /enrollments/{enrollmentId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Progress may move; ownership, the course and anything
      // financial may not.
      allow update: if isAdmin() || (
        ownsDoc()
        && keepsOwner()
        && request.resource.data.get('courseId', '') == resource.data.get('courseId', '')
        && !changes([
          'role', 'paymentStatus', 'price', 'amount',
          'isPaid', 'approved', 'approvedBy'
        ])
      );

      allow delete: if isAdmin();
    }


    // ============================================================
    // 9. QUIZ ATTEMPTS  — server authority, no client writes
    //
    // A client that can create an attempt can set passed: true and
    // isAuthoritativeServerGraded: true on it, and issueCertificate
    // trusts exactly those two fields — so a self-written attempt is
    // a forged certificate. submitQuizAttempt writes these through
    // the Admin SDK, which is not bound by these rules.
    // ============================================================

    match /quizAttempts/{attemptId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // 10. QUIZ RESULTS — server-generated only
    // ============================================================

    match /quizResults/{resultId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // 11. CERTIFICATES
    // ============================================================

    match /certificates/{certificateId} {
      // Public QR verification reads a single certificate by id.
      allow get: if true;
      // Listing would expose every student's name and course.
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // 12. LIBRARY CONTENT
    // ============================================================

    match /books/{bookId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /hadiths/{hadithId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Articles had no rule at all, so the default deny at the foot
    // of this file made the whole section unreachable.
    match /articles/{articleId} {
      allow get, list: if
        resource.data.get('status', 'published') == 'published'
        || resource.data.get('isPublished', true) == true
        || isAdmin();

      allow create, update, delete: if isAdmin() || isInstructor();
    }


    // ============================================================
    // 13. GAME PROGRESS — scoring fields are server-owned
    //
    // A monotonic guard (new_xp >= old_xp) does not stop inflation:
    // 999999999 >= 100 passes. And gameEngine.js stores the score as
    // camelCase totalXp while the Cloud Functions write snake_case
    // total_xp, so the same document holds two XP fields and
    // guarding one leaves the other open. Both are named below.
    //
    // recordGameStageCompletion awards XP through the Admin SDK.
    // Clients may still sync non-scoring progress: current stage,
    // unlocked content, preferences.
    // ============================================================

    match /gameProgress/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // A new player starts from zero.
      allow create: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.get('total_xp', 0) == 0
        && request.resource.data.get('totalXp', 0) == 0
        && request.resource.data.get('streak', 0) == 0
        && request.resource.data.get('level', 1) == 1
      );

      allow update: if isAdmin() || (
        isOwner(userId)
        && !changes([
          'total_xp', 'totalXp', 'level', 'streak',
          'total_quizzes_completed', 'stageAwards'
        ])
      );

      allow delete: if isAdmin();
    }

    // Written server-side by recordGameStageCompletion so the record
    // cannot be back-dated or invented.
    match /gameAttempts/{attemptId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Stage rewards are read by the award function to decide how much
    // XP a stage is worth, so they must not be client-writable.
    match /gameStages/{stageId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /gameWorlds/{worldId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // 14. PERSONAL RECORDS
    // ============================================================

    match /sunnahTrackers/{trackerId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      // Checking only the incoming userId would let anyone capture
      // another person's tracker by rewriting the field.
      allow update: if isAdmin() || (ownsDoc() && keepsOwner());
      allow delete: if isAdmin() || ownsDoc();
    }

    match /studyNotes/{noteId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin() || (ownsDoc() && keepsOwner());
      allow delete: if isAdmin() || ownsDoc();
    }


    // ============================================================
    // 15. NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('userId', '') == 'all'
        )
      );

      allow list: if isAdmin();
      allow create: if isAdmin();

      // Read state only — the recipient cannot be changed.
      allow update: if isAdmin() || (ownsDoc() && keepsOwner());
      allow delete: if isAdmin() || ownsDoc();
    }


    // ============================================================
    // 16. FINANCIAL
    //
    // Payment verification belongs on the server. A client may open
    // a record; it may never mark one paid.
    // ============================================================

    match /donations/{donationId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();

      // Was `allow create: if true`, which let anonymous callers
      // write unlimited documents into a financial collection.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // 17. LOGS — server-generated, admin-readable
    // ============================================================

    match /securityEvents/{eventId} {
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }


    // ============================================================
    // 18. SETTINGS
    // ============================================================

    match /adminSettings/{settingId} {
      allow get, list: if isAdmin();
      allow write: if isAdmin();
    }

    match /publicSettings/{settingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // 19. SERVER-ONLY BOOKKEEPING
    //
    // Reachable only through the Admin SDK. A client that could
    // write these would reset its own rate limit or rewind the
    // certificate serial counter. The default deny below would
    // already cover them; they are named so that stays deliberate.
    // ============================================================

    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
