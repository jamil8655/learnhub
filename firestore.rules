rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // ZERO-TRUST DEFENSE HELPER FUNCTIONS
    // ========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    // NOTE: reading a claim that is not present on the token raises an
    // evaluation error, which fails the whole rule rather than returning
    // false. The emulator reported "Property admin is undefined on object"
    // for every account without the claim, so each lookup uses .get() with a
    // default instead of direct property access.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('role', '') == 'super_admin' ||
        request.auth.token.get('email', '') == 'jrahmanansari@gmail.com' ||
        request.auth.token.get('email', '') == 'jrahmanansari132@gmail.com' ||
        request.auth.token.get('email', '') == 'jrahmanansari133@gmail.com'
      );
    }

    function isInstructor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'instructor' ||
        request.auth.token.get('role', '') == 'teacher'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNotModifyingPrivilegedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'admin', 'superAdmin', 'status', 'emailVerified', 'isVerified'
      ]);
    }

    // ========================================================================
    // 1. USERS COLLECTION (Anti-Privilege Escalation)
    // ========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      // Registration: cannot self-grant admin or instructor role
      allow create: if isSignedIn() && (
        request.resource.data.role == 'student' || 
        !('role' in request.resource.data) || 
        isAdmin()
      );
      // Profile updates: user can update bio/avatar/phone, but NEVER change their own role or status
      allow update: if (isOwner(userId) && isNotModifyingPrivilegedUserFields()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================================================
    // 2. INSTRUCTOR APPLICATIONS & TEACHERS
    // ========================================================================
    match /instructorApplications/{appId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      // Students can submit an application, but cannot mark it 'approved'
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'submitted';
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 3. COURSES & LESSONS (Public Read, Admin/Instructor Write)
    // ========================================================================
    match /courses/{courseId} {
      allow read: if true;

      // On create `resource` is null, so the old single `write` rule (which
      // required `resource != null`) made it impossible for an instructor to
      // create a course at all. Split create from update, and bind the new
      // course to its author so it cannot be filed under someone else.
      allow create: if isAdmin() || (
        isInstructor() && request.resource.data.instructorId == request.auth.uid
      );

      // An instructor may only modify their own course, and may not reassign
      // ownership to or from another instructor.
      allow update: if isAdmin() || (
        isInstructor()
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.instructorId == request.auth.uid
      );

      allow delete: if isAdmin() || (
        isInstructor() && resource.data.instructorId == request.auth.uid
      );
    }
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }

    // ========================================================================
    // 4. QUIZZES & QUESTION BANK (Protected Integrity)
    // ========================================================================
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructor();
    }

    // ========================================================================
    // 5. ENROLLMENTS & LESSON PROGRESS
    // ========================================================================
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );

      // IDOR fix: update must check the EXISTING document's owner. Validating
      // only request.resource.data let a user take over someone else's
      // enrolment by rewriting userId to their own uid.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ========================================================================
    // 6. QUIZ ATTEMPTS & SCORECARDS (Strict Server Authority / Tamper-Proof)
    // ========================================================================
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      // Client cannot forge attempts directly; ONLY Cloud Functions (Admin SDK) or Admin can create
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // 7. CERTIFICATES (Strictly Admin-Issued / Publicly Verifiable)
    // ========================================================================
    match /certificates/{certificateId} {
      allow read: if true; // Public QR verification route
      // Issuance allowed ONLY by verified admin authority (Never client self-issued)
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // 8. ISLAMIC DIGITAL LIBRARY & HADITHS
    // ========================================================================
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================================
    // 9. ISLAMIC ADVENTURE GAME PROGRESS (Bounded Client State)
    // ========================================================================
    match /gameProgress/{userId} {
      allow read: if isSignedIn();

      // A new player starts from zero. Clients cannot open an account already
      // holding XP.
      allow create: if (isOwner(userId) || isAdmin())
                    && request.resource.data.get('total_xp', 0) == 0
                    && request.resource.data.get('streak', 0) == 0
                    && request.resource.data.get('level', 1) == 1;

      // SECURITY: total_xp / level / streak are authoritative and may only be
      // written by Cloud Functions through the Admin SDK, which bypasses these
      // rules. The client may still sync non-scoring progress (current stage,
      // unlocked content, preferences) but can no longer award itself XP.
      // Previously any owner could write total_xp: 999999999 directly.
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['total_xp', 'level', 'streak', 'total_quizzes_completed'])
      );

      allow delete: if isAdmin();
    }
    match /gameAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 10. DAILY SUNNAH & SALAH TRACKER
    // ========================================================================
    match /sunnahTrackers/{trackerId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;

      // IDOR fix: same ownership-on-update flaw as enrollments.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ========================================================================
    // 11. STUDENT STUDY NOTES (Private & Isolated)
    // ========================================================================
    match /studyNotes/{noteId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource != null && resource.data.userId == request.auth.uid || isAdmin());
    }

    // ========================================================================
    // 12. NOTIFICATIONS (User Isolation)
    // ========================================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isAdmin();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ========================================================================
    // 13. DONATIONS & ORDERS (Financial Protection)
    // ========================================================================
    match /donations/{donationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      // Was `allow create: if true`, which let anonymous callers write
      // unlimited documents into a financial collection.
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 14. AUDIT & SECURITY LOGS (Strictly Admin Only)
    // ========================================================================
    match /securityEvents/{eventId} {
      allow read, write: if isAdmin();
    }
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
