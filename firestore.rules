rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // ZERO-TRUST DEFENSE HELPER FUNCTIONS
    // ========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'jrahmanansari@gmail.com' ||
        request.auth.token.email == 'jrahmanansari132@gmail.com' ||
        request.auth.token.email == 'jrahmanansari133@gmail.com'
      );
    }
    
    function isInstructor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'instructor' ||
        request.auth.token.role == 'teacher'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNotModifyingPrivilegedUserFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'admin', 'superAdmin', 'status', 'emailVerified', 'isVerified'
      ]);
    }

    // ========================================================================
    // 1. USERS COLLECTION (Anti-Privilege Escalation)
    // ========================================================================
    match /users/{userId} {
      allow read: if isSignedIn();
      // Registration: cannot self-grant admin or instructor role
      allow create: if isSignedIn() && (
        request.resource.data.role == 'student' || 
        !('role' in request.resource.data) || 
        isAdmin()
      );
      // Profile updates: user can update bio/avatar/phone, but NEVER change their own role or status
      allow update: if (isOwner(userId) && isNotModifyingPrivilegedUserFields()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ========================================================================
    // 2. INSTRUCTOR APPLICATIONS & TEACHERS
    // ========================================================================
    match /instructorApplications/{appId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      // Students can submit an application, but cannot mark it 'approved'
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'submitted';
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 3. COURSES & LESSONS (Public Read, Admin/Instructor Write)
    // ========================================================================
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin() || (isInstructor() && resource != null && resource.data.instructorId == request.auth.uid);
    }
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }

    // ========================================================================
    // 4. QUIZZES & QUESTION BANK (Protected Integrity)
    // ========================================================================
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isInstructor();
    }

    // ========================================================================
    // 5. ENROLLMENTS & LESSON PROGRESS
    // ========================================================================
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ========================================================================
    // 6. QUIZ ATTEMPTS & SCORECARDS (Strict Server Authority / Tamper-Proof)
    // ========================================================================
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      // Students can record their own quiz attempt; Admin can manage all
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 7. CERTIFICATES (Strictly Admin-Issued / Publicly Verifiable)
    // ========================================================================
    match /certificates/{certificateId} {
      allow read: if true; // Public QR verification route
      // Issuance allowed ONLY by verified admin authority (Never client self-issued)
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // 8. ISLAMIC DIGITAL LIBRARY & HADITHS
    // ========================================================================
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ========================================================================
    // 9. ISLAMIC ADVENTURE GAME PROGRESS (Bounded Client State)
    // ========================================================================
    match /gameProgress/{userId} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(userId) || isAdmin())
                            && request.resource.data.total_xp >= 0
                            && request.resource.data.streak >= 0;
      allow delete: if isAdmin();
    }
    match /gameAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 10. DAILY SUNNAH & SALAH TRACKER
    // ========================================================================
    match /sunnahTrackers/{trackerId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ========================================================================
    // 11. STUDENT STUDY NOTES (Private & Isolated)
    // ========================================================================
    match /studyNotes/{noteId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource != null && resource.data.userId == request.auth.uid || isAdmin());
    }

    // ========================================================================
    // 12. NOTIFICATIONS (User Isolation)
    // ========================================================================
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow create: if isAdmin();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ========================================================================
    // 13. DONATIONS & ORDERS (Financial Protection)
    // ========================================================================
    match /donations/{donationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ========================================================================
    // 14. AUDIT & SECURITY LOGS (Strictly Admin Only)
    // ========================================================================
    match /securityEvents/{eventId} {
      allow read, write: if isAdmin();
    }
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
