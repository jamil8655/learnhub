rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (request.auth.uid == userId);
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'administrator' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.role == 'admin'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() || 
        request.auth.token.role == 'teacher' || 
        request.auth.token.role == 'instructor'
      );
    }

    // --- 0. Dedicated Administrators Collection ---
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // --- 1. User Profiles & Private Subcollections ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      match /{subcollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- 2. Courses & Catalogs ---
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    // --- 3. Quizzes & Questions ---
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    // Quiz Answer Keys (Restricted to Admins only)
    match /quizAnswerKeys/{questionId} {
      allow read, write: if isAdmin();
    }

    // --- 4. Enrollments ---
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      allow create, update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- 5. Quiz Attempts & Results ---
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /quizResults/{resultId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- 6. Certificates ---
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    // --- 7. Islamic Books, Hadith & Articles ---
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 8. Notifications ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all' || isAdmin());
      allow write: if isAdmin();
    }

    // --- 9. Gamification (Progress, Attempts, Stages, Worlds) ---
    match /gameProgress/{progressId} {
      allow read, write: if isSignedIn() && (request.auth.uid == progressId || isAdmin());
    }

    match /gameAttempts/{attemptId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    match /gameStages/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameWorlds/{worldId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 10. User Personal Tools (Sunnah Tracker, Study Notes) ---
    match /sunnahTrackers/{trackerId} {
      allow read, write: if isSignedIn() && (request.auth.uid == trackerId || isAdmin());
    }

    match /studyNotes/{noteId} {
      allow read, write: if isSignedIn() && (resource.data.userId == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- 11. Orders & Payments ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // --- 12. Security & Audit Logs ---
    match /securityEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // --- 13. System Settings ---
    match /adminSettings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /publicSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
