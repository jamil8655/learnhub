rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // LEARNHUB — ENTERPRISE ROLE-BASED LEAST-PRIVILEGE SECURITY RULES (v189.0.0)
    // Zero hardcoded emails | Pure Custom Claims | Strict Field-Level Validation
    // =========================================================================

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && (getRole() == 'super_admin' || request.auth.token.admin == true);
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        getRole() == 'admin'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        isAdmin() ||
        getRole() == 'teacher' ||
        getRole() == 'instructor'
      );
    }

    function isCourseTeacher(courseData) {
      return isTeacher() && (
        courseData.instructorId == request.auth.uid ||
        courseData.teacherId == request.auth.uid ||
        isAdmin()
      );
    }

    // --- 1. User Profiles (/users/{userId}) ---
    match /users/{userId} {
      // Owner and Admin can read full profile
      allow read: if isOwner(userId) || isAdmin();
      
      // User can create their initial profile document upon registration with safe defaults
      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student') &&
        (!('admin' in request.resource.data) || request.resource.data.admin == false) &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false);

      // User can update only safe profile fields. Role and Admin privileges CANNOT be self-escalated.
      allow update: if (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin) &&
        (!('isPremium' in request.resource.data) || request.resource.data.isPremium == resource.data.isPremium)
      ) || isAdmin();

      // Only SuperAdmin can delete user accounts
      allow delete: if isSuperAdmin();

      // --- Canonical Subcollection: /users/{userId}/enrollments/{courseId} ---
      match /enrollments/{courseId} {
        allow read: if isOwner(userId) || isAdmin();

        // Safe creation: Only allowed if user assigns to themselves with matching UID
        allow create: if (
          isOwner(userId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.courseId == courseId
        ) || isAdmin();

        // Student updates allowed ONLY for learning progress fields (completedLessons, progressPercentage, lastViewedLessonId)
        allow update: if (
          isOwner(userId) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.courseId == resource.data.courseId &&
          request.resource.data.enrolledAt == resource.data.enrolledAt
        ) || isAdmin();

        allow delete: if isAdmin();
      }

      // --- Subcollection: Course Progress ---
      match /courseProgress/{courseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      // --- Subcollection: User Certificates ---
      match /certificates/{certId} {
        allow read: if true; // Publicly verifiable certificate
        // Students CANNOT issue certificates to themselves — only Teachers/Admins can write certificates
        allow write: if isTeacher() || isAdmin();
      }

      // --- Subcollection: User Bookmarks & Notes ---
      match /bookmarks/{bookmarkId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /notes/{noteId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /{subcollection=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // --- 2. Global Top-Level Enrollments Index (/enrollments/{enrollmentId}) ---
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      
      allow create: if (
        isSignedIn() &&
        request.resource.data.userId == request.auth.uid
      ) || isAdmin();

      allow update: if (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.courseId == resource.data.courseId
      ) || isAdmin();

      allow delete: if isAdmin();
    }

    match /courseEnrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // --- 3. Certificates & Official Diplomas (/certificates/{certId}) ---
    match /certificates/{certificateId} {
      // Public verification page can inspect certificate details
      allow read: if true;
      // Students CANNOT create, update or forge certificates
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    // --- 4. Course Catalog & Lesson Content (/courses & /lessons) ---
    match /courses/{courseId} {
      allow read: if true; // Public catalog
      // SuperAdmin and Admin can edit all; Teachers can edit only their assigned courses
      allow create: if isTeacher() || isAdmin();
      allow update: if isAdmin() || isCourseTeacher(resource.data);
      allow delete: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow create, update, delete: if isTeacher() || isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 5. Quizzes & Exam System ---
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- 6. Orders, Invoices & Subscriptions ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if true; // Guests can donate
      allow update, delete: if isAdmin();
    }

    // --- 7. Islamic Adventure Game Progress & SAGAS ---
    match /gameProgress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /gameAttempts/{attemptId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /gameStages/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameWorlds/{worldId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- 8. Classical Library Books, Tafsir & Hadiths ---
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    // --- 9. Audit Logs (/auditLogs) ---
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Students cannot forge audit logs
    }

    // --- 10. Default Deny Fallback ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
