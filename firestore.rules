rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // LEARNHUB — PRODUCTION FIRESTORE SECURITY RULES (V183.0.0)
    // ============================================================

    // ------------------------------------------------------------
    // AUTHENTICATION & OWNERSHIP HELPERS
    // ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.get('email', '') == userId
      );
    }

    // ------------------------------------------------------------
    // ADMIN & INSTRUCTOR AUTHORITY
    // ------------------------------------------------------------

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('role', '') == 'super_admin' ||
        request.auth.token.get('email', '') == 'jrahmanansari@gmail.com' ||
        request.auth.token.get('email', '') == 'jrahmanansari132@gmail.com' ||
        request.auth.token.get('email', '') == 'jrahmanansari133@gmail.com'
      );
    }

    function isInstructor() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'instructor' ||
        request.auth.token.get('role', '') == 'teacher'
      );
    }

    function ownsDoc() {
      return isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('userEmail', '') == request.auth.token.get('email', '')
      );
    }

    function keepsOwner() {
      return request.resource.data.get('userId', '') == resource.data.get('userId', '');
    }

    function changes(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function privilegedUserFieldsChanged() {
      return changes([
        'role', 'admin', 'superAdmin', 'status', 'emailVerified',
        'isVerified', 'permissions', 'isInstructor', 'isTeacher'
      ]);
    }


    // ============================================================
    // 1. USERS & PROFILES
    // ============================================================

    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        request.auth.token.get('email', '') == userId
      ) && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'student' ||
        isAdmin()
      );

      allow update: if isAdmin() || (isOwner(userId) && !privilegedUserFieldsChanged());
      allow delete: if isAdmin();
    }


    // ============================================================
    // 2. INSTRUCTOR APPLICATIONS
    // ============================================================

    match /instructorApplications/{appId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'submitted';

      allow update, delete: if isAdmin();
    }


    // ============================================================
    // 3. COURSES & LESSONS
    // ============================================================

    match /courses/{courseId} {
      allow get, list: if
        resource.data.get('status', '') == 'published'
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if isAdmin()
        || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid);

      allow update: if isAdmin() || (
        isInstructor()
        && resource.data.get('instructorId', '') == request.auth.uid
        && request.resource.data.get('instructorId', '') == request.auth.uid
      );

      allow delete: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);
    }

    match /lessons/{lessonId} {
      allow get, list: if
        resource.data.get('status', 'published') == 'published'
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if isAdmin() || isInstructor();

      allow update, delete: if isAdmin() || (
        isInstructor()
        && resource.data.get('instructorId', '') == request.auth.uid
      );
    }


    // ============================================================
    // 4. QUIZZES & QUESTIONS
    // ============================================================

    match /quizzes/{quizId} {
      allow get, list: if
        resource.data.get('status', 'published') == 'published'
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if isAdmin()
        || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid);

      allow update: if isAdmin() || (
        isInstructor()
        && resource.data.get('instructorId', '') == request.auth.uid
        && request.resource.data.get('instructorId', '') == request.auth.uid
      );

      allow delete: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);
    }

    match /questions/{questionId} {
      allow get, list: if
        (
          isSignedIn()
          && !('correctAnswer' in resource.data)
          && !('answerKey' in resource.data)
          && !('correctAnswers' in resource.data)
          && !('correctOption' in resource.data)
        )
        || isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create: if (
        isAdmin() || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid)
      )
        && !('correctAnswer' in request.resource.data)
        && !('answerKey' in request.resource.data)
        && !('correctAnswers' in request.resource.data)
        && !('correctOption' in request.resource.data);

      allow update: if (
        isAdmin() || (
          isInstructor()
          && resource.data.get('instructorId', '') == request.auth.uid
          && request.resource.data.get('instructorId', '') == request.auth.uid
        )
      )
        && !('correctAnswer' in request.resource.data)
        && !('answerKey' in request.resource.data)
        && !('correctAnswers' in request.resource.data)
        && !('correctOption' in request.resource.data);

      allow delete: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);
    }

    match /quizAnswerKeys/{questionId} {
      allow read: if isAdmin()
        || (isInstructor() && resource.data.get('instructorId', '') == request.auth.uid);

      allow create, update, delete: if isAdmin()
        || (isInstructor() && request.resource.data.get('instructorId', '') == request.auth.uid);
    }


    // ============================================================
    // 5. ENROLLMENTS & COURSE PROGRESS (Cloud Persistent)
    // ============================================================

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('userEmail', '') == request.auth.token.get('email', '')
      ));

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin() || (
        (resource.data.get('userId', '') == request.auth.uid || resource.data.get('userEmail', '') == request.auth.token.get('email', ''))
        && request.resource.data.get('userId', '') == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    match /courseEnrollments/{enrollmentId} {
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('userEmail', '') == request.auth.token.get('email', '')
      ));
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /courseProgress/{progressId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }


    // ============================================================
    // 6. QUIZ ATTEMPTS & RESULTS
    // ============================================================

    match /quizAttempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /quizResults/{resultId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // 7. CERTIFICATES & RECOGNITION (Verifiable Publicly)
    // ============================================================

    match /certificates/{certificateId} {
      allow get, list: if true;
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // 8. BOOKMARKS & STUDY NOTES
    // ============================================================

    match /userBookmarks/{bookmarkId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
    }

    match /studyNotes/{noteId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
    }


    // ============================================================
    // 9. GAME PROGRESS & SAGAS
    // ============================================================

    match /gameProgress/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /gameAttempts/{attemptId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /gameStages/{stageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameWorlds/{worldId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ============================================================
    // 10. CONTENT & BOOKS
    // ============================================================

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hadiths/{hadithId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin() || isInstructor();
    }

    match /quran_recitation_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    // ============================================================
    // 11. FINANCIAL & ORDERS
    // ============================================================

    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.get('userId', '') == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }


    // ============================================================
    // 12. LOGS & AUDITS
    // ============================================================

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /xp_transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.get('userId', '') == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
