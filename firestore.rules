rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && (getRole() == 'super_admin' || request.auth.token.admin == true);
    }

    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || getRole() == 'admin');
    }

    function isTeacher() {
      return isSignedIn() && (isAdmin() || getRole() == 'teacher' || getRole() == 'instructor');
    }

    // --- 1. User Profiles (/users/{userId}) ---
    match /users/{userId} {
      allow read, create, update: if isOwner(userId) || isAdmin();
      allow delete: if isSuperAdmin();

      // Canonical Subcollection: /users/{userId}/enrollments/{courseId}
      match /enrollments/{courseId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /courseProgress/{courseId} {
        allow read, create, update: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /certificates/{certId} {
        allow read: if true;
        allow write: if isTeacher() || isAdmin();
      }

      match /{subcollection=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- 2. Global Top-Level Enrollments Index ---
    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTeacher());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- 3. Orders ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- 4. Certificates ---
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    // --- 5. Course Catalog ---
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isTeacher() || isAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
