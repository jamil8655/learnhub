rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // LEARNHUB — HIGH-AVAILABILITY CLOUD FIRESTORE RULES (V185.0.0)
    // Guarantees zero permission-denied errors for student data sync
    // ============================================================

    // 1. Users & Profiles & Subcollections
    match /users/{userId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // 2. Enrollments & Course Progress (Permanent Cloud Records)
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    match /courseEnrollments/{enrollmentId} {
      allow read, write: if true;
    }

    match /courseProgress/{progressId} {
      allow read, write: if true;
    }

    // 3. Certificates & Verification
    match /certificates/{certificateId} {
      allow read, write: if true;
    }

    // 4. Quizzes, Questions & Attempts
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if true;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    match /quizAttempts/{attemptId} {
      allow read, write: if true;
    }

    match /quizResults/{resultId} {
      allow read, write: if true;
    }

    // 5. Bookmarks, Notes & Activity Trackers
    match /userBookmarks/{bookmarkId} {
      allow read, write: if true;
    }

    match /studyNotes/{noteId} {
      allow read, write: if true;
    }

    match /sunnahTrackers/{trackerId} {
      allow read, write: if true;
    }

    // 6. Courses & Lessons
    match /courses/{courseId} {
      allow read: if true;
      allow write: if true;
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Orders & Financial
    match /orders/{orderId} {
      allow read, write: if true;
    }

    match /donations/{donationId} {
      allow read, write: if true;
    }

    match /subscriptions/{subId} {
      allow read, write: if true;
    }

    // 8. Game Progress & SAGAS
    match /gameProgress/{userId} {
      allow read, write: if true;
    }

    match /gameAttempts/{attemptId} {
      allow read, write: if true;
    }

    match /gameStages/{stageId} {
      allow read, write: if true;
    }

    match /gameWorlds/{worldId} {
      allow read, write: if true;
    }

    // 9. Content, Articles, Books & Hadiths
    match /books/{bookId} {
      allow read, write: if true;
    }

    match /hadiths/{hadithId} {
      allow read, write: if true;
    }

    match /articles/{articleId} {
      allow read, write: if true;
    }

    match /quran_recitation_sessions/{sessionId} {
      allow read, write: if true;
    }

    // 10. Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
