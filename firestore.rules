rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('role', '') == 'super_admin' ||
        request.auth.token.get('email', '') == 'jrahmanansari@gmail.com' ||
        request.auth.token.get('email', '') == 'jrahmanansari132@gmail.com' ||
        request.auth.token.get('email', '') == 'jrahmanansari133@gmail.com'
      );
    }
    function isInstructor() {
      return isSignedIn() && (isAdmin() || request.auth.token.get('role', '') == 'instructor' || request.auth.token.get('role', '') == 'teacher');
    }
    function ownsDoc() { return isSignedIn() && resource.data.get('userId', '') == request.auth.uid; }
    function keepsOwner() { return request.resource.data.get('userId', '') == resource.data.get('userId', ''); }
    function changes(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }
    function noPrivilegedUserChanges() {
      return !changes(['role','admin','superAdmin','status','emailVerified','isVerified','permissions','isInstructor','isTeacher']);
    }

    match /users/{userId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role == 'student'));
      allow update: if isAdmin() || (isOwner(userId) && noPrivilegedUserChanges());
      allow delete: if isAdmin();
    }

    match /instructorApplications/{appId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'submitted';
      allow update, delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow get, list: if resource.data.get('status','') == 'published' || isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid);
      allow create: if isAdmin() || (isInstructor() && request.resource.data.get('instructorId','') == request.auth.uid);
      allow update: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid && request.resource.data.get('instructorId','') == request.auth.uid);
      allow delete: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid);
    }

    match /lessons/{lessonId} {
      allow get, list: if resource.data.get('status','published') == 'published' || isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid);
      allow create: if isAdmin() || isInstructor();
      allow update, delete: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid);
    }

    match /quizzes/{quizId} {
      allow get, list: if resource.data.get('status','published') == 'published' || isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid);
      allow create: if isAdmin() || (isInstructor() && request.resource.data.get('instructorId','') == request.auth.uid);
      allow update: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid && request.resource.data.get('instructorId','') == request.auth.uid);
      allow delete: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid);
    }

    match /questions/{questionId} {
      allow get, list: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid) || (isSignedIn() && !('correctAnswer' in resource.data) && !('answerKey' in resource.data) && !('correctAnswers' in resource.data) && !('correctOption' in resource.data));
      allow create, update: if isAdmin() || (isInstructor() && request.resource.data.get('instructorId','') == request.auth.uid);
      allow delete: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid);
    }
    match /quizAnswerKeys/{questionId} { allow read, write: if isAdmin() || (isInstructor() && resource.data.get('instructorId','') == request.auth.uid); }
    match /quizzes/{quizId}/secretQuestions/{questionId} { allow read, write: if false; }

    match /enrollments/{enrollmentId} {
      allow get: if isAdmin() || ownsDoc();
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (ownsDoc() && keepsOwner() && !changes(['paymentStatus','price','amount','isPaid','approved','approvedBy','role']));
      allow delete: if isAdmin();
    }
    match /quizAttempts/{attemptId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /quizResults/{resultId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /certificates/{certificateId} { allow get: if true; allow list: if isAdmin(); allow create, update, delete: if isAdmin(); }

    match /books/{bookId} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /hadiths/{hadithId} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /articles/{articleId} { allow get, list: if resource.data.get('status','published') == 'published' || resource.data.get('isPublished',true) == true || isAdmin(); allow create, update, delete: if isAdmin() || isInstructor(); }

    // Quran/Tafsir canonical text and metadata: admin writes only; users read published content.
    match /quran_surahs/{surahId} { allow get, list: if resource.data.get('status','published') == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /quran_ayahs/{ayahId} { allow get, list: if resource.data.get('status','published') == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /quran_translations/{translationId} { allow get, list: if resource.data.get('status','published') == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /quran_documents/{documentId} { allow get, list: if resource.data.get('active',false) == true && resource.data.get('status','published') == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /tafsirs/{tafsirId} { allow get, list: if resource.data.get('status','published') == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /tafsir_entries/{entryId} { allow get, list: if resource.data.get('status','published') == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /status_card_templates/{templateId} { allow get, list: if resource.data.get('status','published') == 'published' || isAdmin(); allow create, update, delete: if isAdmin(); }
    match /generated_status_cards/{cardId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if isAdmin() || ownsDoc(); }

    match /gameProgress/{userId} { allow get: if isAdmin() || isOwner(userId); allow list: if isAdmin(); allow create: if isAdmin() || isOwner(userId); allow update: if isAdmin() || (isOwner(userId) && !changes(['total_xp','totalXp','level','streak','total_quizzes_completed','stageAwards'])); allow delete: if isAdmin(); }
    match /gameAttempts/{attemptId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /gameStages/{stageId} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }
    match /gameWorlds/{worldId} { allow get, list: if isSignedIn(); allow create, update, delete: if isAdmin(); }

    match /sunnahTrackers/{trackerId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update: if isAdmin() || (ownsDoc() && keepsOwner()); allow delete: if isAdmin() || ownsDoc(); }
    match /studyNotes/{noteId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update: if isAdmin() || (ownsDoc() && keepsOwner()); allow delete: if isAdmin() || ownsDoc(); }
    match /notifications/{notificationId} { allow get: if isAdmin() || (isSignedIn() && (resource.data.get('userId','') == request.auth.uid || resource.data.get('userId','') == 'all')); allow list: if isAdmin(); allow create: if isAdmin(); allow update: if isAdmin() || (ownsDoc() && keepsOwner()); allow delete: if isAdmin() || ownsDoc(); }
    match /donations/{donationId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if isAdmin(); }
    match /orders/{orderId} { allow get: if isAdmin() || ownsDoc(); allow list: if isAdmin(); allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if isAdmin(); }
    match /securityEvents/{eventId} { allow get, list, write: if isAdmin(); }
    match /auditLogs/{logId} { allow get, list, write: if isAdmin(); }
    match /adminSettings/{settingId} { allow get, list, write: if isAdmin(); }
    match /publicSettings/{settingId} { allow get, list: if true; allow create, update, delete: if isAdmin(); }
    match /rateLimits/{limitId} { allow read, write: if false; }
    match /counters/{counterId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
