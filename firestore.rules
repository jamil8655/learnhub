rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTHORIZATION HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Public signup may create only a student profile.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student';

      // Users may update normal profile information, but cannot
      // change identity, role, status, email or creation timestamp.
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // COURSES
    // =========================================================

    match /courses/{courseId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // LESSONS
    // =========================================================

    match /lessons/{lessonId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // QUIZZES
    // =========================================================

    match /quizzes/{quizId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // QUIZ QUESTIONS
    // =========================================================

    match /questions/{questionId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // ENROLLMENTS
    // =========================================================

    match /enrollments/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // A student cannot change ownership, course or payment state.
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.courseId == resource.data.courseId
          && request.resource.data.paymentStatus == resource.data.paymentStatus
          && request.resource.data.amount == resource.data.amount
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // QUIZ ATTEMPTS
    // =========================================================

    match /quizAttempts/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // Submitted attempts cannot be edited/deleted by students.
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // GAME PROGRESS
    // =========================================================

    match /gameProgress/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // =========================================================
    // GAME ATTEMPTS
    // =========================================================

    match /gameAttempts/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // CERTIFICATES
    // =========================================================

    // Public read is intentional for certificate/QR verification.
    // Only Admin can create, modify or delete certificates.
    match /certificates/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // DONATIONS
    // =========================================================

    match /donations/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    // =========================================================
    // ORDERS / PAYMENTS
    // =========================================================

    match /orders/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      // Payment state must be changed by trusted backend/Admin only.
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // SUPPORT TICKETS
    // =========================================================

    match /supportTickets/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // SUNNAH TRACKERS
    // =========================================================

    match /sunnahTrackers/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // INSTRUCTORS
    // =========================================================

    match /instructors/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // SECURITY / AUDIT LOGS
    // =========================================================

    match /auditLogs/{id} {
      allow read, write: if isAdmin();
    }

    match /securityEvents/{id} {
      allow read, write: if isAdmin();
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
