rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // ZERO-TRUST DEFENSE HELPER FUNCTIONS
    // ========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'jrahmanansari@gmail.com' ||
        request.auth.token.email == 'jrahmanansari132@gmail.com' ||
        request.auth.token.email == 'jrahmanansari133@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ========================================================================
    // 1. USERS COLLECTION (Permanent Profile Persistence & Public Read)
    // ========================================================================
    match /users/{userId} {
      // Public read so student & instructor profiles render everywhere
      allow read: if true;
      // Allow profile create & update for active users & administrators
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // ========================================================================
    // 2. INSTRUCTOR APPLICATIONS & TEACHERS
    // ========================================================================
    match /instructorApplications/{appId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ========================================================================
    // 3. COURSES & REVIEWS (Public Read, Admin/Instructor Write)
    // ========================================================================
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
      
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    // ========================================================================
    // 4. CERTIFICATES (Public Verification via QR Code / Serial Number)
    // ========================================================================
    match /certificates/{certId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ========================================================================
    // 5. ISLAMIC ADVENTURE GAME WORLDS & LEADERBOARDS
    // ========================================================================
    match /gameWorlds/{worldId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gameLeaderboard/{entryId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ========================================================================
    // 6. GENERAL FALLBACK (Secure Default)
    // ========================================================================
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }
  }
}
